# ── Django ────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=zmien-mnie-na-losowy
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,taxpilot.cytr.us
DJANGO_CSRF_TRUSTED_ORIGINS=https://taxpilot.cytr.us

# ── PostgreSQL (system of record) ─────────────────────────────────
POSTGRES_DB=taxpilot
POSTGRES_USER=taxpilot
POSTGRES_PASSWORD=taxpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Celery / Redis ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Semantyczny cache odpowiedzi (Redis, osobna baza /2) ──────────
CACHE_REDIS_URL=redis://localhost:6379/2
CACHE_TTL_SECONDS=604800
CACHE_SEMANTIC_THRESHOLD=0.95
CACHE_MAX_ENTRIES=1000

# ── OpenSearch ────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=taxpilot
POLISH_STEM_FILTER=polish_stem

# ── Embedder ──────────────────────────────────────────────────────
EMBED_MODEL=sdadas/stella-pl-retrieval-mini-8k

# ── Ollama (generacja RAG) ────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_CLOUD_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:cloud

# ── ELI API ───────────────────────────────────────────────────────
ELI_API_BASE=https://api.sejm.gov.pl/eli
